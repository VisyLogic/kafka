{
  "name": "eventflow",
  "version": "REPLACE_WITH_SUPPORTED_VERSION",
  "roleArn": "arn:aws:iam::ACCOUNT_ID:role/EventFlowClusterRole",
  "accessConfig": {
    "authenticationMode": "API_AND_CONFIG_MAP"
  },
  "resourcesVpcConfig": {
